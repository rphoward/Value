---
description: USE WHEN creating, moving, or placing files; product home is src/value/; skill session data is workproduct/; skills live under .cursor/skills/ (ship mirror skills/).
alwaysApply: true
---

(def-sop repo-layout
  (context
    (target "any-agent-working-in-this-workspace")
    (optimization "one-named-product-home-plus-skills-and-workproduct-session-data"))

  <central_idea>
  (center-of-gravity
    (invariant "Scaffold product code lives under product_home src/value/ (import value). Skill prose and scripts live under .cursor/skills/ with an informal ship mirror at skills/. Skill session and progress data live under workproduct/ — no Python there. The repo root is workspace shell plus supporting trees."))
  </central_idea>

  (protocol-0-write-path-gate
    (note "Path-scoped rules inject on glob match; literal globs — retarget at scaffold init. Injection does not enforce placement.")
    (before (Write StrReplace EditNotebook)
      (resolve product_home from protocol-1)
      (if (python-under-workproduct? target-path)
          (progn (halt-generation) (forbidden 'python-under-workproduct)))
      (if (implementation-code-or-layer-tree? target-path)
          (if (and (not (under? target-path product_home))
                   (not (under? target-path tests/))
                   (not (under? target-path tools/))
                   (not (under? target-path .cursor/))
                   (not (under? target-path workproduct/))
                   (not (under? target-path skills/)))
              (progn
                (halt-generation)
                (forbidden 'write-outside-allowed-homes)
                (write-only-under product_home 'tests/ 'tools/ '.cursor/ 'workproduct/ 'skills/)))))
    (forbidden-root-level-dirs
      'core 'application 'infrastructure 'presentation 'value 'app 'lib 'server 'api 'backend 'frontend)
    (note "Root skills/ is the informal ship mirror — not a forbidden-root-level-dir and not a portable product_home.")
    (note "DDD layer folders stay under src/<slug>/; do not recreate bare core/application/… at repo root."))

  (protocol-1-product-home
    (value
      (product_home "src/value/")
      (import_package "value")
      (repo_folder "value")
      (layers "src/<slug>/core/ application/ infrastructure/ presentation/")
      (note "Scaffold default for a finished product under src/<slug>/. A blank project starts with exactly those four layer folders; scaffold init retargets <slug>. See core-domain.mdc, application-layer.mdc, infrastructure-wiring.mdc, presentation-surface.mdc — their globs are src/value/<layer>/**."))
    (enforce (scaffold-product-under product-home :when scaffolded))
    (enforce (four-layer-tree-under product-home :when scaffolded))
    (portable-default "repo-root/<project-slug>/ when slug-named folder is the product home in other repos"))

  (protocol-1b-workproduct
    (value
      (workproduct_root "workproduct/")
      (role "skill session and progress state — e.g. workproduct/<skill-area>/<slug>/")
      (note "Agents may create workproduct/<skill-area>/<slug>/ trees without asking. Not ship-output junk."))
    (enforce (all-skill-session-data-under workproduct_root))
    (forbidden 'python-under-workproduct))

  (protocol-2-root-staging-yard
    (allow (user-drops-docs 'experiments 'temporary-junk-manually-into-root))
    (allow (skill-session-trees-under workproduct/))
    (allow (ship-mirror-edits-under skills/))
    (forbidden (agent-creating-junk 'build-artifacts 'generated-files-in-root-without-explicit-permission)))

  (protocol-3-supporting-trees
    (enforce (supporting-material-in-named-subfolders-not-mixed-into-product-home))
    (roles
      (src/value/ "optional four-layer spoke product — import value")
      (workproduct/ "skill session and progress data; no Python")
      (skills/ "informal this-repo ship mirror of .cursor/skills/ — write-allowed, not a portable product_home declaration")
      (docs/ "human-facing prose when present")
      (CONTEXT.md "domain language at repo root")
      (tests/ "verification at repo root; see pyproject for pythonpath")
      (tools/ "local scripts (e.g. start-value.ps1); any tools/**/*.py still under thermonuclear.mdc; tools/drafts/ for promote-before-commit drafts")
      (tools/drafts/agents/ "subagent drafts → ship to .cursor/agents/ before check-in")
      (tools/drafts/skills/ "skill drafts → ship to .cursor/skills/ before check-in")
      (tools/drafts/hooks/ "hook config/script drafts → ship to .cursor/hooks.json and .cursor/hooks/ before check-in")
      (handoff/ "gate records and living state; see handoff-authoring.mdc")
      (.cursor/ "agent rules, IDE config, .cursor/plans/, .cursor/agents/, .cursor/skills/, hooks")
      (.cursor/agents/ "custom subagent .md files; see agent-authoring.mdc")
      (.cursor/skills/ "project skills <name>/SKILL.md; see skill-authoring.mdc and skills-repo.mdc")
      (.cursor/hooks.json ".cursor/hooks/ hook scripts; see hooks-authoring.mdc"))
    (absent-here (Planner/ assets/ DocTools/ Docs/ — do not create without explicit user request)))

  (protocol-4-explicit-permission-gate
    (if (and (would-place-generated-or-ship-output-at-repo-root)
             (not (under? target-path workproduct/))
             (not (under? target-path skills/)))
        (progn (halt) (ask-user-explicit-permission) (wait-for-resolution)))))
